# Copy to .env — every value has a working default in docker-compose.yml;
# only fill what you need (oauth keys, stripe, smtp, real secrets for prod).

# --- app -------------------------------------------------------------------
APP_PORT=8080
APP_URL=http://localhost:8080
APP_LOCALE=fr
# `production` enables production-only side effects (Discord webhooks).
APP_ENV=local
# Shared with Laravel's config('app.key') — signs reset/email-verify HMACs.
APP_KEY=base64:YmxpbmVzdC1sb2NhbC1kZXYta2V5LWRvLW5vdC11c2UtaW4tcHJvZA==

# --- postgres --------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_PORT=5432
# Host port for direct psql/dev access to the DB (app uses db:5432 inside).
PG_HOST_PORT=5433
REDIS_HOST_PORT=6379
CACHE_PREFIX=blindall_cache_

# --- traefik (prod only, docker-compose.traefik.yml) -------------------------
DOMAIN=
TRAEFIK_NETWORK=traefik
# Root-domain verification site (AdSense/Search Console), profile `rootverify`.
ROOT_DOMAIN=

# --- providers ---------------------------------------------------------------
AUDIUS_APP_NAME=blindall
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=FR
YOUTUBE_API_KEY=

# --- mail --------------------------------------------------------------------
# MAIL_ENCRYPTION: starttls (587) | tls (465) | none (dev relay)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=starttls
MAIL_FROM_ADDRESS=no-reply@blindall.test
MAIL_FROM_NAME=Blind'All Music

# --- donations ---------------------------------------------------------------
STRIPE_DONATION_URL=
STRIPE_PLUS_URL=
STRIPE_PRO_URL=
STRIPE_WEBHOOK_SECRET=
DONATIONS_MONTHLY_GOAL_CENTS=15000

# --- ads (empty = ads fully disabled) ----------------------------------------
ADSENSE_CLIENT_ID=
ADSENSE_SLOT=

# --- oauth (callback URLs must match the provider console) -------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/callback/google
DISCORD_APP_ID=
DISCORD_APP_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8080/callback/discord

# --- storage -----------------------------------------------------------------
STORAGE_DISK=local
# Fallback host serving files missing locally (legacy Laravel storage).
STORAGE_UPSTREAM_URL=

# --- observability -------------------------------------------------------------
# Warn in server logs when a request exceeds N ms (default 500).
SLOW_REQUEST_MS=500
# Postgres logs statements slower than N ms to `docker logs db` (default 300).
PG_SLOW_QUERY_MS=300

# --- misc --------------------------------------------------------------------
HIDDEN_CATEGORY_IDS=
# Local only: seed a playable demo room ("Démo", /rooms/demo) + tracks.
# Set to 0 / unset in production.
SEED_DEMO=1
