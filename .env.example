# Copy to .env : every value has a working default in docker-compose.yml;
# only fill what you need (oauth keys, stripe, brevo, REAL secrets for prod).

# --- app -----------------------------------------------------------------
APP_PORT=8080
APP_URL=http://localhost:8080
# Domaine servi par le service `edge` (Caddy) : alpha → xxx.duckdns.org
DOMAIN=
WWW_DOMAIN=
APP_LOCALE=fr
# Laravel APP_ENV : Discord webhooks fire only when `production`.
APP_ENV=local
# Shared with Laravel's config('app.key'), signs reset/email-verify HMACs.
APP_KEY=base64:YmxpbmVzdC1sb2NhbC1kZXYta2V5LWRvLW5vdC11c2UtaW4tcHJvZA==
REDIS_HOST_PORT=6379
CACHE_PREFIX=blindall_cache_

# --- supabase core (CHANGE ALL OF THESE FOR PRODUCTION) --------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=your-super-secret-and-long-postgres-password
POSTGRES_PORT=5432
# Host port for direct psql/dev access to the raw DB (app uses db:5432 inside).
PG_HOST_PORT=5433

# Legacy HS256 JWT : the demo ANON/SERVICE keys below are signed with THIS
# secret; changing JWT_SECRET requires regenerating both keys.
JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJhbm9uIiwKICAgICJpc3MiOiAic3VwYWJhc2UtZGVtbyIsCiAgICAiaWF0IjogMTY0MTc2OTIwMCwKICAgICJleHAiOiAxNzk5NTM1NjAwCn0.dc_X5iR_VP_qT0zsiyj_I_OZ2T9FtRU2BBNWN8Bu4GE
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyAgCiAgICAicm9sZSI6ICJzZXJ2aWNlX3JvbGUiLAogICAgImlzcyI6ICJzdXBhYmFzZS1kZW1vIiwKICAgICJpYXQiOiAxNjQxNzY5MjAwLAogICAgImV4cCI6IDE3OTk1MzU2MDAKfQ.DaYlNEoUrrEn2Ig7tqibS-PHK5vgusbcbo7X36XVt4Q
JWT_EXPIRY=3600

# Kong API gateway (supabase public URL, auth/rest/realtime/storage/studio)
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=18443  # 8443 taken by another local supabase stack
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000/auth/v1
SITE_URL=http://localhost:8080
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=this_password_is_insecure_and_should_be_updated

# Studio / meta
STUDIO_DEFAULT_ORGANIZATION=Blind'All Music
STUDIO_DEFAULT_PROJECT=blindall
PG_META_CRYPTO_KEY=your-encryption-key-32-chars-min
OPENAI_API_KEY=
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000

# GoTrue mailer → inbucket (catch-all; web UI http://localhost:9000)
SMTP_HOST=mail
SMTP_PORT=2500
SMTP_ADMIN_EMAIL=admin@blindall.test
SMTP_SENDER_NAME=Blind'All Music
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
DISABLE_SIGNUP=false
ADDITIONAL_REDIRECT_URLS=
INBUCKET_SMTP_PORT=2500
INBUCKET_WEB_PORT=9000
INBUCKET_POP3_PORT=1100

# Realtime / pooler / storage / analytics internals
SECRET_KEY_BASE=UpNVntn3cDxHJpq99YMc1T1AQgQpc8kfYTuRgBiYa15BLrx8etQoXz3gZv1/u2oq
REALTIME_DB_ENC_KEY=supabaserealtime
VAULT_ENC_KEY=your-32-character-encryption-key
POOLER_TENANT_ID=your-tenant-id
# Host ports for supavisor (5432/6543 may already be used by another stack).
POOLER_SESSION_HOST_PORT=55432
POOLER_PROXY_PORT_TRANSACTION=56543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_DB_POOL_SIZE=5
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=stub
S3_PROTOCOL_ACCESS_KEY_ID=625729a08b95bf1b7ff351a663f3a23c
S3_PROTOCOL_ACCESS_KEY_SECRET=850181e4652dd023b7a98c58ae0d2d34bd487ee0cc3254aed6eda37307425907
IMGPROXY_AUTO_WEBP=true
LOGFLARE_PUBLIC_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-public
LOGFLARE_PRIVATE_ACCESS_TOKEN=your-super-secret-and-long-logflare-key-private
DOCKER_SOCKET_LOCATION=/var/run/docker.sock
FUNCTIONS_VERIFY_JWT=false

# --- migration (docker compose --profile migration) ------------------------
# Source = the legacy Laravel MySQL volume. Target = the supabase db.
MYSQL_DATABASE=blindall
MYSQL_USERNAME=blindall
MYSQL_PASSWORD=blindall
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3306

# --- providers / integrations (optional) ---------------------------------
AUDIUS_APP_NAME=blindall
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=FR
YOUTUBE_API_KEY=

# --- mail ----------------------------------------------------------------
BREVO_KEY=
MAIL_FROM_ADDRESS=no-reply@blindall.test
MAIL_FROM_NAME=Blind'All Music

# --- donations -----------------------------------------------------------
STRIPE_DONATION_URL=
STRIPE_WEBHOOK_SECRET=
DONATIONS_MONTHLY_GOAL_CENTS=15000

# --- ads (empty = ads fully disabled) ------------------------------------
ADSENSE_CLIENT_ID=
ADSENSE_SLOT=

# --- oauth (callback URLs must match the provider console) ----------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_APP_ID=
DISCORD_APP_SECRET=

STORAGE_DISK=local

# --- misc -----------------------------------------------------------------
HIDDEN_CATEGORY_IDS=
# Local only: seed a playable demo room ("Démo", slug /rooms/demo) + tracks.
# Set to 0 / unset in production.
SEED_DEMO=1
