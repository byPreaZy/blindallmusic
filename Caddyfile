# Blind'All Music : terminateur TLS. Caddy provisionne automatiquement un
# certificat Let's Encrypt dès que le DNS pointe sur l'hôte.
#
#   DOMAIN=blindall-alpha.duckdns.org  (alpha / test)
#   DOMAIN=blindallmusic.com         (prod)
#   WWW_DOMAIN=www.blindallmusic.com (optionnel, redirige le www)

{$DOMAIN:localhost} {
	reverse_proxy server:8080

	# /ws?ticket=... et autres paramètres : jamais dans les access logs.
	log {
		format filter {
			wrap console
			fields {
				uri>query {
					action delete
				}
			}
		}
	}
}

{$WWW_DOMAIN:www.localhost} {
	redir https://{$DOMAIN}{uri} permanent
}
