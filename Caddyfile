# Blind'All Music : TLS terminator. Caddy auto-provisions Let's Encrypt
# certificates as soon as the DNS A/AAAA records point at this host.

blindallmusic.com {
    reverse_proxy server:8080

    # /ws?token=... — keep bearer tokens out of access logs
    log {
        format transform "{common_log}" {
            request>uri query delete
        }
    }
}

www.blindallmusic.com {
    redir https://blindallmusic.com{uri} permanent
}
